# Mission 3 — Environment Variables
# Copy this file to .env and fill in your keys.

# Required for all agent files
DEEPSEEK_API_KEY=your_deepseek_api_key_here


# The one switch for the 06a / 06b experiment.
# Leave it false. Flip to true to pretend the vendor shipped an update:
#   - the API renames a field  -> the glue agent (06a) BREAKS
#   - the MCP server adds a tool -> the MCP agent (06b) keeps working and gains it
VENDOR_UPDATE=false
